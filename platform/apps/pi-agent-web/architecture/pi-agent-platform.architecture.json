  "cards": [
    {
      "dot": "cyan",
      "title": "多入口共用一套会话能力",
      "items": [
        "Server 同时托管 /ide/ 与 /web/；HTTP 提交请求，SSE 回传事件流",
        "IDE 插件在仓库根，JCEF 通过 ide-bridge 与 Kotlin 侧通信"
      ]
    },
    {
      "dot": "emerald",
      "title": "进程与持久化分工",
      "items": [
        "每会话一个子进程；master ↔ worker 只有 call / event / reverse-call 三通道",
        "SQLite 只存元数据；pi SDK 自管 jsonl 历史与工作区文件"
      ]
    },
    {
      "dot": "amber",
      "title": "扩展面三道口子各自收口",
      "items": [
        "插件：四类 facet + 两层闸门；能力：callServer 双道闸；触发器：cron / once / webhook"
      ]
    }
  ]
