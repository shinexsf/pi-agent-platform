  "cards": [
    {
      "dot": "rose",
      "title": "双道闸：看见 ≠ 允许",
      "items": [
        "道闸 1（prompt 层）：serverBuiltinTools 决定 callServer 注不注入，模型根本看不见工具",
        "道闸 2（强制层）：dispatch 时校验显式 allowlist + 硬编码 own 安全网，归属解析不到就 fail closed"
      ]
    },
    {
      "dot": "cyan",
      "title": "可见性 = 强制性",
      "items": [
        "同一个 resolve 函数被五处共享：授权判定、spawn 时的 description 过滤、list、detail、未知方法可用列表",
        "改授权语义只改 registry 一处，master 是唯一强制点；worker 不做任何授权判断"
      ]
    },
    {
      "dot": "emerald",
      "title": "会话快照语义",
      "items": [
        "session 行有 capabilities key（数组或显式 null）就用它，缺 key 才回落 agent 行",
        "null（显式未授权）≠ undefined（没快照过）；能力清单缺失即空，没有全局默认层"
      ]
    }
  ]
