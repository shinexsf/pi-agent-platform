  "cards": [
    {
      "dot": "cyan",
      "title": "五字段与默认值",
      "items": [
        "reverse：默认 true（漏了会静默坏）",
        "scope：默认 own，public 要显式声明",
        "service / tool / http：默认关闭（漏了会明确报错）",
        "tool 必须给 params 且 reverse 不能为 false"
      ]
    },
    {
      "dot": "emerald",
      "title": "为什么收敛成一个声明",
      "items": [
        "以前同一件事要写四遍：工具、HTTP、service、反向方法",
        "一份 handler 只写一次，四张投影各自推导名字与路径",
        "工具名冲突不许静默改名：后到者拒绝并 warn"
      ]
    },
    {
      "dot": "amber",
      "title": "已经这样用的插件",
      "items": [
        "admin：8 个动作，四投影全开（工具 deferred + namespace admin）",
        "im：im.sendFile 一个动作 → sendFileToUser 工具",
        "scheduler / webhook：聚合动作各一个工具 + 细粒度 service"
      ]
    }
  ]
