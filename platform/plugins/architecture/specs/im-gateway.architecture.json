  "cards": [
    {
      "dot": "cyan",
      "title": "依赖倒置怎么解耦",
      "items": [
        "网关只声明 namespace：im.channel（不认 qq / wechat）",
        "渠道把自己的 driver 注册成 service，网关按 provider 拉取",
        "加载无序靠两条兜底：目录快照 + __core__.plugin.loaded 广播"
      ]
    },
    {
      "dot": "emerald",
      "title": "绑定三级路由",
      "items": [
        "显式 chat 绑定 → 连接默认会话 → 自动新建",
        "走默认会话后会落显式绑定：改默认不改道已进过的聊天",
        "换 agent 清空绑定与 defaultSessionId"
      ]
    },
    {
      "dot": "amber",
      "title": "渠道自己的 UI",
      "items": [
        "新增连接流程由渠道提供（QQ 扫码/手填、微信扫码）",
        "网关只负责把槽位里的组件装进弹窗（失败隔离）",
        "凭据与登录态写 host.dataDir/state/<id>/（升级不覆盖）"
      ]
    }
  ]
