  "cards": [
    {
      "dot": "cyan",
      "title": "内核只留四件事",
      "items": [
        "会话管理（SessionRegistry / WorkerPool / 附件库）",
        "agent 与 session 配置（唯一开关是 AgentConfig.plugins）",
        "插件宿主（装载点 + 11 个注册扩展点 + 卸载账本）",
        "基础设施（pino 日志 / SQLite / 路径归一）"
      ]
    },
    {
      "dot": "emerald",
      "title": "一切的归属判据",
      "items": [
        "插件停用 → 它提供的工具 / 页面 / 路由 / skill 一起消失",
        "平台仍能建 agent、开会话、聊完一轮才算真插件",
        "内核里没有 HTTP 框架、没有渠道实现、没有业务表"
      ]
    },
    {
      "dot": "amber",
      "title": "入口与内核的缝",
      "items": [
        "入口只做装配：路由、SSE、静态托管、debug 端点",
        "插件拿到的 host 由入口实现（HostApi 是唯一稳定缝）",
        "event-projection 是独立包，worker 事件 → 会话 DTO"
      ]
    }
  ]
}
