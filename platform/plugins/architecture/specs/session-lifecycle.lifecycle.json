  "cards": [
    {
      "dot": "cyan",
      "title": "对象 = 进程",
      "items": [
        "Session 对象存在即 worker 存活，没有独立的状态字段要同步",
        "占位会话被超时扫描回收，活跃会话永不自动杀（有 DB 行就有人管）",
        "重启 worker 复用历史：会话行里的配置优先于 agent 默认值"
      ]
    },
    {
      "dot": "emerald",
      "title": "三个终态语义",
      "items": [
        "disposed：worker 没了（事件 session_disposed，SSE 关流可重连）",
        "crashed：异常退出，下条消息自动重开而不是丢会话",
        "deleted：行 + pi 会话文件 + 附件目录级联清掉"
      ]
    },
    {
      "dot": "amber",
      "title": "谁在改状态",
      "items": [
        "status 字段已 deprecated：存活判据是 worker 状态，不是 DB 字段",
        "busy 由 Session 自己记（streamingBehavior 决定排队还是插队）",
        "IM 渠道绑定与默认会话都是插件侧的 state.json，不进 sessions 表"
      ]
    }
  ]
}
