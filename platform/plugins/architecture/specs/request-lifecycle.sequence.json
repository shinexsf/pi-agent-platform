  "cards": [
    {
      "dot": "cyan",
      "title": "三段职责",
      "items": [
        "worker：只负责把 pi 的原生事件无损转发（coalescing 不改语义）",
        "projection：把原生事件投影成会话 DTO（正文增量、工具调用、用量）",
        "入口：只做序列化与限流，SSE 一条连接对应一次订阅"
      ]
    },
    {
      "dot": "emerald",
      "title": "内核在哪里出现",
      "items": [
        "Session 是订阅的唯一入口：多订阅者、幂等退订、终态通知",
        "SessionRegistry 管 worker 生命周期，WorkerPool 只管进程",
        "信封只由 buildSystemEnvelope 构造，插件只给结构化字段"
      ]
    },
    {
      "dot": "amber",
      "title": "出错与终态",
      "items": [
        "worker 崩溃 → 会话拿到 session_disposed 终态事件，SSE 关流后可重连",
        "慢订阅者被丢弃而不是回压（不让前端卡住整轮生成）",
        "busy 时按 streamingBehavior 排队或插队，内核不解释业务"
      ]
    }
  ]
