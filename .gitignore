# Editor / IDE
/.idea/
/.vscode/

# Pi state + private docs/skills: separate git repo at .pi/.git (ignored here on purpose)
/.pi/

# Dev logs (rotating, written by the unified logger)
/platform/apps/pi-agent-server/logs/

# Personal — not for public
/openspec/

# Build artefacts
*.tgz
dist/

# Runtime data (server)
/data.db*
/logs/
*.log
/platform/apps/pi-agent-server/data.db
/platform/apps/pi-agent-server/data.db-shm
/platform/apps/pi-agent-server/data.db-wal
/platform/apps/pi-agent-server/public/ide/
/platform/apps/pi-agent-server/public/web/

# IntelliJ plugin build/cache
/pi-agent-idea/.gradle/
/pi-agent-idea/.intellijPlatform/
/pi-agent-idea/build/

# Node
node_modules/

# Integration-test agent workspace (agent-facing fixtures; local only)
/test-workspace/

# 临时屏蔽：android-app 为开发中目录，待正式版设计定稿后随首次提交入库
/android-app/

# Misc
/tmp/
/nul
/pi-agent-idea/.kotlin/

# 本机自用插件开发目录（非 bundled，只对本机 pi-server 生效；不进代码库、不进 tgz）
# 布局与命令见 plugins/README.md；脚手架复制自 _template/
/plugins/

# dev 专用数据目录（插件 registry / 隔离配置），与已安装实例分开
/platform/.dev-data/

# bundled 插件的 web 产物（由 pnpm build:plugins 生成，源码在 web/src/*.ts）
/platform/plugins/*/web/*.js

# 插件的 vendored 类型（`plugin check` 生成，随插件目录分发但不进仓库）
/platform/**/types/plugin-types/
